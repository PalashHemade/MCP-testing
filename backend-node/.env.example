# Copy to .env and fill in real values. Never commit .env.
#
# ---- Database ---------------------------------------------------------
# App's own connection - the restricted, RLS-subject `app_runtime_node` role
# (see migrations/ for how it's created). Mirrors the Python backend's
# two-role design at ../backend/docs equivalent - see docs/security.md.
DATABASE_URL=postgresql://app_runtime_node:app_runtime_dev_password@localhost:5433/logistics_demo_node

# Privileged, table-owning role - used only by migrations/seed/reset
# scripts, which must bypass RLS to see/write every row.
ADMIN_DATABASE_URL=postgresql://logistics:logistics_dev_password@localhost:5433/logistics_demo_node

# ---- Gemini -------------------------------------------------------------
# Leave empty to run with the deterministic FakePlannerClient (no network
# calls; used automatically in tests regardless of this value).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Knowledge (OKF) ----------------------------------------------------
# Path to the OKF bundle root, relative to this backend's working directory.
KNOWLEDGE_ROOT=../knowledge
KNOWLEDGE_MAX_CONTEXT_CHARS=12000

# ---- App ------------------------------------------------------------
APP_ENV=development
AUTH_MODE=dev
FRONTEND_ORIGIN=http://localhost:5173
DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
PORT=8001

# Set to true only for local/test databases. Guards destructive reset scripts.
ALLOW_DESTRUCTIVE_DB_OPERATIONS=true

# MCP server (official TS SDK, Streamable HTTP transport)
MCP_TRANSPORT=streamable-http
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8766

LOG_LEVEL=info
