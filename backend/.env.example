# Copy this file to .env and fill in real values. Never commit .env.
#
# ---- Database ---------------------------------------------------------
# DATABASE_URL: the RUNNING APP's own connection, as the `app_runtime` role
# created by migration 0002. This role owns nothing and is not a
# superuser, so Postgres Row-Level Security (tenant + customer isolation
# on trips/trip_billing/trip_expenses) actually applies to it - see
# docs/security.md "Row-Level Security".
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime_dev_password@localhost:5433/logistics_demo

# ADMIN_DATABASE_URL: migrations/seeding/resets/embedding-rebuilds need the
# table-owning role (`logistics`) - it must bypass RLS to see/write every
# row regardless of tenant/customer scope. Never used by request-handling
# code (app.api.*, app.mcp.tools.*, app.services.*).
ADMIN_DATABASE_URL=postgresql+asyncpg://logistics:logistics_dev_password@localhost:5433/logistics_demo

# Supabase example (direct connection, required for Alembic DDL/migrations -
# Supabase's *transaction-mode pooler* (port 6543) does NOT reliably support
# DDL, prepared statements, or session-level features migrations need).
# On Supabase, ADMIN_DATABASE_URL would be the project's postgres/owner
# role, and DATABASE_URL a separate restricted role you create (mirroring
# app_runtime) that migration 0002's policies actually apply to:
# ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Optional separate URL for Alembic (same asyncpg driver format as above),
# only needed if migrations should run against a different connection than
# ADMIN_DATABASE_URL (e.g. Supabase *direct* connection while admin scripts
# otherwise use a pooler). Defaults to ADMIN_DATABASE_URL if unset.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase session-mode pooler (port 5432 via pooler host) is fine for normal
# async app traffic; the *direct* connection (above) should be used for
# migrations. Document which one you're using when deploying.

# ---- Gemini -------------------------------------------------------------
# Leave GEMINI_API_KEY empty to run with the deterministic FakeGeminiClient
# (no network calls, used automatically in tests / AUTH_MODE=dev when unset).
# Model availability varies by API key/project and changes over time -
# verify what your key can actually use before assuming these defaults
# work (see docs/evaluation.md "Troubleshooting a real Gemini setup" for a
# ListModels snippet). GEMINI_EMBEDDING_DIMENSIONS is requested explicitly
# via output_dimensionality on every embedding call, so it's safe to leave
# at 768 even for a model whose native size differs (e.g.
# gemini-embedding-001 defaults to 3072) - no DB migration needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ---- App ------------------------------------------------------------
APP_ENV=development
AUTH_MODE=dev
FRONTEND_ORIGIN=http://localhost:5173
DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111

# Set to true only for local/test databases. Guards destructive reset scripts.
ALLOW_DESTRUCTIVE_DB_OPERATIONS=true

# MCP server (FastMCP, Streamable HTTP transport)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

LOG_LEVEL=INFO
